{
  "version": "0.9",
  "index_id": "fuzz-index",
  "index_uri": "ram:///indexes/fuzz-index",
  "doc_mapping": {
    "mode": "dynamic",
    "timestamp_field": "timestamp",
    "index_field_presence": true,
    "store_source": false,
    "tag_fields": ["severity"],
    "field_mappings": [
      {
        "name": "timestamp",
        "type": "datetime",
        "input_formats": ["rfc3339", "unix_timestamp"],
        "fast": true
      },
      { "name": "severity", "type": "text", "tokenizer": "raw" },
      { "name": "body", "type": "text", "tokenizer": "default", "record": "position" },
      { "name": "count", "type": "i64", "fast": true },
      { "name": "attributes", "type": "json", "tokenizer": "default" }
    ]
  },
  "indexing_settings": {
    "commit_timeout_secs": 30,
    "merge_policy": { "type": "stable_log", "max_merge_ops": 3 }
  },
  "search_settings": { "default_search_fields": ["body", "severity"] },
  "retention": { "period": "7 days", "schedule": "daily" }
}
